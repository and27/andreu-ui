{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/index.ts"],
  "exclude": [
    "**/*.stories.*",
    "**/*.test.*",
    "src/stories/**",
    "src/test/**",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
